#!/bin/sh
# Garde-fou de construction : fait échouer la construction si l'image ne respecte
# pas les choix de Tɔlɔmɛ.
#  - Evolution (l'application) et le méta-paquet gnome absents ; evolution-data-server
#    reste nécessaire à GNOME Agenda, Contacts et au calendrier du menu horloge ;
#  - un seul terminal : GNOME Terminal (ni Zutty ni xterm) ;
#  - Thunderbird en français, sudo-rs, sudo, nala et les paquets Tɔlɔmɛ présents ;
#  - le thème de l'écran de connexion contient le fond, l'image de profil par défaut
#    est celle de Tɔlɔmɛ, et la commande « dada » est unique ;
#  - le thème de l'écran de connexion a la carte d'utilisateur translucide, et l'avatar par défaut
#    est posé pour GDM (tolome-avatar : outil, image, unités .service et .path activées) ;
#  - le branding de Calamares est celui de Tɔlɔmɛ (aucun logo, titre ni lanceur Debian) ;
#  - ckbcomp (console-setup) est présent : il dessine l'aperçu du clavier de Calamares ;
#  - les polices Noto des écritures de la liste des langues de Calamares sont installées ;
#  - les locales fr_BJ et fon_BJ sont compilées et listées dans SUPPORTED (détourné), sans
#    changer la langue par défaut (LANG reste fr_FR.UTF-8).
set -e

installe() {
    [ "$(dpkg-query -W -f='${Status}' "$1" 2>/dev/null)" = "install ok installed" ]
}
erreur() { echo "ERREUR : $*" >&2; exit 1; }

for p in evolution evolution-plugins gnome zutty xterm; do
    installe "$p" && erreur "le paquet '$p' est installé (à ne pas installer : Evolution, méta-paquet gnome ou second terminal)."
done
for p in evolution-data-server gnome-calendar gnome-contacts thunderbird thunderbird-l10n-fr gnome-terminal \
         sudo-rs sudo nala tolome-base tolome-artwork tolome-keyboard-fon tolome-dada tolome-gdm-theme \
         tolome-calamares-settings tolome-locales; do
    installe "$p" || erreur "le paquet '$p' est absent (requis par Tɔlɔmɛ)."
done

# Thème de l'écran de connexion : fond de Tɔlɔmɛ intégré (mode image, par défaut)
THEME=/usr/share/gnome-shell/gnome-shell-theme.gresource
if ! gresource list "$THEME" | grep -q tolome-gdm-background.png; then
    erreur "le thème de GNOME Shell ne contient pas le fond de l'écran de connexion (tolome-gdm-theme)."
fi
[ -f "$THEME.distrib" ] || erreur "le thème d'origine ($THEME.distrib) est absent : détournement manquant."
# Carte d'utilisateur translucide (tolome-gdm-theme >= 0.2.0) dans les feuilles sombre et claire
for feuille in dark light; do
    gresource extract "$THEME" "/org/gnome/shell/theme/gnome-shell-$feuille.css" | grep -q 'tolome-user-card' \
        || erreur "le thème de GNOME Shell n'a pas la carte d'utilisateur translucide dans gnome-shell-$feuille.css (tolome-gdm-theme)."
done

# Avatar par défaut pour GDM (tolome-base >= 0.4.0) : outil, image et unités activées
[ -x /usr/lib/tolome/set-avatar ] || erreur "/usr/lib/tolome/set-avatar est absent ou non exécutable (tolome-base)."
[ -f /usr/share/tolome/face.png ] || erreur "/usr/share/tolome/face.png est absent (tolome-base)."
for unite in tolome-avatar.service tolome-avatar.path; do
    [ -f "/usr/lib/systemd/system/$unite" ] || erreur "l'unité $unite est absente (tolome-base)."
    [ -L "/etc/systemd/system/multi-user.target.wants/$unite" ] || erreur "l'unité $unite n'est pas activée (multi-user.target.wants)."
done

# Image de profil par défaut : PNG de Tɔlɔmɛ, et non plus le SVG de desktop-base
if [ "$(head -c 4 /etc/skel/.face | od -An -c | tr -d ' ')" != "211PNG" ] && ! head -c 8 /etc/skel/.face | grep -q PNG; then
    erreur "/etc/skel/.face n'est pas l'image de Tɔlɔmɛ (PNG)."
fi

# os-release : Tɔlɔmɛ, ID_LIKE=debian
grep -q '^ID=tolome$' /usr/lib/os-release && grep -q '^ID_LIKE=debian$' /usr/lib/os-release \
    || erreur "os-release ne décrit pas Tɔlɔmɛ (ID=tolome, ID_LIKE=debian)."

# « dada » : une seule commande de ce nom, fournie par tolome-dada
[ "$(dpkg -S /usr/bin/dada 2>/dev/null | cut -d: -f1)" = "tolome-dada" ] || erreur "/usr/bin/dada n'appartient pas à tolome-dada."

# Locale fr_BJ : compilée, listée par locale -a et par SUPPORTED (Calamares), SUPPORTED
# d'origine conservé en .distrib ; la langue par défaut reste fr_FR.UTF-8.
locale -a | grep -qx 'fr_BJ.utf8' || erreur "la locale fr_BJ.utf8 n'est pas listée par « locale -a » (tolome-locales)."
[ -f /usr/lib/locale/fr_BJ.utf8/.tolome-locales ] || erreur "/usr/lib/locale/fr_BJ.utf8 n'a pas été compilée par tolome-locales."
grep -qx 'fr_BJ.UTF-8 UTF-8' /usr/share/i18n/SUPPORTED || erreur "SUPPORTED ne contient pas fr_BJ.UTF-8 (Calamares ne la proposerait pas)."
[ -f /usr/share/i18n/SUPPORTED.distrib ] || erreur "SUPPORTED.distrib absent : détournement de SUPPORTED manquant."
grep -qx 'fr_FR.UTF-8 UTF-8' /usr/share/i18n/SUPPORTED.distrib || erreur "SUPPORTED.distrib ne ressemble pas au fichier d'origine de locales."
# Locale fon_BJ (tolome-locales >= 0.2.0) : même contrôles.
locale -a | grep -qx 'fon_BJ.utf8' || erreur "la locale fon_BJ.utf8 n'est pas listée par « locale -a » (tolome-locales)."
[ -f /usr/lib/locale/fon_BJ.utf8/.tolome-locales ] || erreur "/usr/lib/locale/fon_BJ.utf8 n'a pas été compilée par tolome-locales."
grep -qx 'fon_BJ.UTF-8 UTF-8' /usr/share/i18n/SUPPORTED || erreur "SUPPORTED ne contient pas fon_BJ.UTF-8 (Calamares ne la proposerait pas)."
if [ -f /etc/default/locale ] && grep -q -E 'fr_BJ|fon_BJ' /etc/default/locale; then
    erreur "/etc/default/locale désigne fr_BJ ou fon_BJ : la langue par défaut ne doit pas changer."
fi
if [ -f /etc/default/locale ] && ! grep -q '^LANG=.*fr_FR.UTF-8' /etc/default/locale; then
    erreur "/etc/default/locale : LANG n'est pas fr_FR.UTF-8."
fi

# Calamares : branding Tɔlɔmɛ verrouillé (aucun élément Debian)
installe calamares-settings-debian && erreur "calamares-settings-debian est installé : il doit être remplacé par tolome-calamares-settings."
SETTINGS=/etc/calamares/settings.conf
[ -f "$SETTINGS" ] || erreur "$SETTINGS est absent (tolome-calamares-settings)."
grep -qx 'branding: tolome' "$SETTINGS" || erreur "$SETTINGS ne pointe pas vers le branding « tolome »."
[ "$(dpkg -S "$SETTINGS" 2>/dev/null | cut -d: -f1)" = "tolome-calamares-settings" ] \
    || erreur "$SETTINGS n'appartient pas à tolome-calamares-settings."
BRANDING=/usr/share/calamares/branding/tolome
for f in branding.desc show.qml tolome-logo.png welcome.png; do
    [ -f "$BRANDING/$f" ] || erreur "$BRANDING/$f est absent (branding Calamares)."
done
grep -q -i 'debian' "$BRANDING/branding.desc" && erreur "branding.desc de Tɔlɔmɛ mentionne Debian (titre ou logo)."
grep -q '^ *productName: *Tɔlɔmɛ' "$BRANDING/branding.desc" || erreur "branding.desc : productName n'est pas Tɔlɔmɛ (titre de l'installateur)."
grep -q '^ *productLogo: *"tolome-logo.png"' "$BRANDING/branding.desc" || erreur "branding.desc : productLogo n'est pas tolome-logo.png (logo de la barre latérale)."
# Un seul autre branding toléré : « default » (fourni par calamares, jamais sélectionné)
for dir in /usr/share/calamares/branding/*/; do
    nom=$(basename "$dir")
    case "$nom" in tolome|default) ;; *) erreur "branding Calamares inattendu : $dir" ;; esac
done
[ -e /usr/share/calamares/branding/debian ] && erreur "un branding Calamares « debian » est présent."
# Lanceurs : celui de Tɔlɔmɛ existe ; aucun lanceur Calamares ne s'appelle ou ne porte l'icône Debian
LAUNCHER=/usr/share/applications/calamares-install-tolome.desktop
[ -f "$LAUNCHER" ] || erreur "$LAUNCHER est absent (lanceur de l'installateur)."
grep -q '^Icon=tolome$' "$LAUNCHER" || erreur "$LAUNCHER n'a pas l'icône « tolome »."
[ -f /usr/share/icons/hicolor/scalable/apps/tolome.svg ] || [ -f /usr/share/icons/hicolor/256x256/apps/tolome.png ] \
    || [ -n "$(ls /usr/share/icons/hicolor/*/apps/tolome.* 2>/dev/null)" ] || erreur "l'icône « tolome » du lanceur est absente."
grep -q -i 'debian' "$LAUNCHER" && erreur "$LAUNCHER mentionne Debian."
for f in /usr/share/applications/*calamares*.desktop; do
    grep -q -E '^(Name|Icon)(\[[^]]*\])?=.*[Dd]ebian' "$f" && erreur "le lanceur $f porte un nom ou une icône Debian."
done
# Lanceur d'origine de Calamares : détourné et masqué (NoDisplay), icône Tɔlɔmɛ
[ -f /usr/share/applications/calamares.desktop.distrib ] || erreur "calamares.desktop n'est pas détourné (tolome-calamares-settings)."
grep -qx 'NoDisplay=true' /usr/share/applications/calamares.desktop || erreur "calamares.desktop d'origine n'est pas masqué (NoDisplay=true)."
grep -qx 'Icon=tolome' /usr/share/applications/calamares.desktop || erreur "calamares.desktop n'a pas l'icône « tolome » (dock)."
grep -q "calamares-install-tolome.desktop" /usr/share/glib-2.0/schemas/96_tolome-calamares-settings.gschema.override \
    || erreur "le dock n'épingle pas calamares-install-tolome.desktop."
# Aperçu du clavier de Calamares : ckbcomp (console-setup)
[ -x /usr/bin/ckbcomp ] || erreur "/usr/bin/ckbcomp est absent (aperçu du clavier de Calamares vide ; paquet console-setup)."

# Polices Noto des écritures de la liste des langues de Calamares
installe fonts-noto-core || erreur "fonts-noto-core est absent (hindi, marathi, malayalam, thaï, cingalais en carrés)."
installe fonts-noto-cjk || erreur "fonts-noto-cjk est absent (coréen, chinois, japonais en carrés)."

echo "Contrôle des paquets Tɔlɔmɛ : OK"
