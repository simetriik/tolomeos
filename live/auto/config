#!/bin/sh
# Configuration live-build de Tɔlɔmɛ (première image minimale).
set -e

lb config noauto \
    --distribution trixie \
    --architectures amd64 \
    --archive-areas "main contrib non-free-firmware" \
    --bootloaders "grub-pc,grub-efi" \
    --binary-images iso-hybrid \
    --debian-installer none \
    --iso-volume "Tolome" \
    --iso-application "Tolome" \
    --iso-publisher "Nemim Sarl / Simetriik Solutions" \
    --image-name "tolome" \
    --bootappend-live "boot=live components quiet splash locales=fr_FR.UTF-8 keyboard-layouts=fon,fr timezone=Africa/Porto-Novo hostname=tolome username=tolome" \
    "${@}"
