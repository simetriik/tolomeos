#!/bin/sh
set -e

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-remove" ]; then
    # Logos du fournisseur (GDM, emblème) : priorité 80 > desktop-base (50).
    EM=/usr/share/tolome/emblems
    update-alternatives --install /usr/share/images/vendor-logos vendor-logos \
        /usr/share/tolome/vendor-logos 80 \
        --slave /usr/share/icons/vendor/64x64/emblems/emblem-vendor.png emblem-vendor-64 $EM/emblem-vendor-64.png \
        --slave /usr/share/icons/vendor/128x128/emblems/emblem-vendor.png emblem-vendor-128 $EM/emblem-vendor-128.png \
        --slave /usr/share/icons/vendor/256x256/emblems/emblem-vendor.png emblem-vendor-256 $EM/emblem-vendor-256.png \
        --slave /usr/share/icons/vendor/scalable/emblems/emblem-vendor.svg emblem-vendor-scalable $EM/emblem-vendor-scalable.svg \
        --slave /usr/share/icons/vendor/64x64/emblems/emblem-vendor-symbolic.png emblem-vendor-symbolic-64 $EM/emblem-vendor-symbolic-64.png \
        --slave /usr/share/icons/vendor/128x128/emblems/emblem-vendor-symbolic.png emblem-vendor-symbolic-128 $EM/emblem-vendor-symbolic-128.png \
        --slave /usr/share/icons/vendor/256x256/emblems/emblem-vendor-symbolic.png emblem-vendor-symbolic-256 $EM/emblem-vendor-symbolic-256.png \
        --slave /usr/share/icons/vendor/scalable/emblems/emblem-vendor-symbolic.svg emblem-vendor-symbolic-scalable $EM/emblem-vendor-symbolic-scalable.svg \
        --slave /usr/share/icons/vendor/64x64/emblems/emblem-vendor-white.png emblem-vendor-white-64 $EM/emblem-vendor-white-64.png \
        --slave /usr/share/icons/vendor/128x128/emblems/emblem-vendor-white.png emblem-vendor-white-128 $EM/emblem-vendor-white-128.png \
        --slave /usr/share/icons/vendor/256x256/emblems/emblem-vendor-white.png emblem-vendor-white-256 $EM/emblem-vendor-white-256.png \
        --slave /usr/share/icons/vendor/scalable/emblems/emblem-vendor-white.svg emblem-vendor-white-scalable $EM/emblem-vendor-white-scalable.svg
fi

#DEBHELPER#

exit 0
