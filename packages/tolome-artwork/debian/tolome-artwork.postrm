#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # Retour au thème par défaut si le thème Tɔlɔmɛ était actif.
    if command -v plymouth-set-default-theme >/dev/null 2>&1 \
       && [ "$(plymouth-set-default-theme 2>/dev/null)" = "tolome" ]; then
        plymouth-set-default-theme --reset || true
        if command -v update-initramfs >/dev/null 2>&1; then
            update-initramfs -u || true
        fi
    fi
fi

#DEBHELPER#

exit 0
