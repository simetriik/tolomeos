#!/bin/sh
###
# Lanceur de Calamares sur le média live Tɔlɔmɛ
# (d'après calamares-install-debian de calamares-settings-debian)
###

# Fichier fstab laissé par live-build : gêne le partitionnement
sudo mv /etc/fstab /etc/fstab.orig.calamares

export QT_AUTO_SCREEN_SCALE_FACTOR=1

# Droit d'exécuter calamares en root sous Xwayland
xhost +si:localuser:root
pkexec calamares
xhost -si:localuser:root

# Restaure le fstab d'origine
sudo mv /etc/fstab.orig.calamares /etc/fstab
